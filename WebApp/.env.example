# Supabase
# Get from: Supabase Console → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=   # antes llamada ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=                       # Solo para scripts del servidor (seed, bot WhatsApp)

# Clerk
# Get from: clerk.com → your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Telegram Bot
# Get from: @BotFather → /newbot → token
TELEGRAM_BOT_TOKEN=

# WhatsApp Bot (Meta Cloud API) - pendiente
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
